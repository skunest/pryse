# Pryse: invoicing and e-signing for Maanda Attorneys Inc.

# Set to production ONLY on the live system. Anything else (or not set) is a
# testing system: every screen, PDF and email is marked TESTING.
NEXT_PUBLIC_PRYSE_ENV=qa

# This app's public address (used in invite, password and signing links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project for Pryse (its own project, separate from the website)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server only. Never expose this to a browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
